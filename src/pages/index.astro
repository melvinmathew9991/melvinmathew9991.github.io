---
// Home page. Content comes from src/data/site.ts and the featured entries in src/content/projects/.
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.jsx';
import ContactForm from '../components/ContactForm.astro';
import { getProjects } from '../lib/projects';
import { profile, aboutStats, corrections, experience, experienceLabel, skills, education, certifications } from '../data/site';

const featured = await getProjects((p) => p.tier === 'featured');
const total = (await getProjects()).length;
---
<Base>
  <!-- Hero: where and availability, name, role, one-paragraph pitch, and two actions. -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-text">
      <p class="availability">
        <span class="dot" aria-hidden="true"></span>
        <span>{profile.location} · Open to opportunities</span>
      </p>
      <h1 id="hero-title">{profile.name}</h1>
      <p class="role"><span class="prompt" aria-hidden="true">&gt;</span> Data Scientist &amp; AI/ML Engineer<span class="caret" aria-hidden="true"></span></p>
      <p class="lede read">
        I build and ship machine learning and LLM systems (fraud detection, demand forecasting, credit risk and
        RAG applications) and test them until the numbers hold up. Currently building with XGBoost, LightGBM,
        LangChain and FastAPI, deployed on Google Cloud Run.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="#projects">View projects</a>
        <a class="btn" href="#contact">Get in touch</a>
      </div>
    </div>
    <picture class="portrait">
      <source srcset="/melvin-mathew.webp" type="image/webp" />
      <img src="/melvin-mathew.jpg" alt="Portrait of Melvin Mathew" width="320" height="320" fetchpriority="high" />
    </picture>
  </section>

  <!-- Sections below follow the header menu order: About, Experience, Projects, Skills, Achievements, Contact. -->

  <!-- About: hook, intro beside the headline numbers, then the working method. -->
  <section id="about" class="wrap section" aria-labelledby="about-title">
    <h2 id="about-title" class="eyebrow">About</h2>
    <p class="hook">From a maths degree to machine learning that holds up in production</p>

    <div class="about-top">
      <div class="about-text">
        <p class="about-lead">
          I'm a Data Scientist and AI/ML Engineer with {experienceLabel()} of experience, building everything from
          classical ML (classification, credit risk, forecasting) to RAG chatbots and tool-calling LLM agents.
        </p>
        <p>
          I work end-to-end: data pipelines and features, time-ordered evaluation against honest baselines, then
          tested FastAPI services on Google Cloud Run with CI/CD and drift monitoring. For LLM work I use FAISS,
          ChromaDB, LangChain and Ollama, with golden-set evaluation gates on every change.
        </p>
        <p>
          My BSc in Mathematics means I build models I can explain and defend, not just tune. I'm looking for
          Data Scientist, ML Engineer and AI Engineer roles, in Bengaluru, Hyderabad, Chennai or anywhere else, and I
          take on freelance projects.
        </p>
      </div>

      <!-- Headline numbers: every one is backed elsewhere on the site (sources in src/data/site.ts). -->
      <dl class="stats">
        {/* dt before dd for valid HTML; CSS shows the number first. */}
        <div><dt>projects, each with public code or a live dashboard</dt><dd class="num">{total}</dd></div>
        {aboutStats.map((s) => <div><dt>{s.label}</dt><dd class="num">{s.value}</dd></div>)}
      </dl>
    </div>

    <!-- The working method. The three steps are a real sequence, so they are numbered. -->
    <h3 class="method-title">How I work</h3>
    <ol class="method" role="list">
      <li><span class="step num" aria-hidden="true">01</span><strong>Reproduce it.</strong> Rerun the result exactly before trusting or changing anything.</li>
      <li><span class="step num" aria-hidden="true">02</span><strong>Try to break it.</strong> Look for leakage, weak baselines and evaluation that flatters the model.</li>
      <li><span class="step num" aria-hidden="true">03</span><strong>Measure and say so.</strong> Report the honest number, including when a target was missed.</li>
    </ol>
  </section>

  <!-- Experience timeline: wording from LinkedIn. -->
  <section id="experience" class="wrap section" aria-labelledby="exp-title">
    <h2 id="exp-title">Experience</h2>
    <ol class="timeline" role="list">
      {experience.map((job) => (
        <li>
          <p class="when num">{job.dates}</p>
          <div>
            <h3>{job.role}</h3>
            <p class="org">{job.org}</p>
            {job.note && <p class="muted small">{job.note}</p>}
            <ul>
              {job.points.map((pt) => <li>{pt}</li>)}
            </ul>
            {job.tools && (
              <p class="tools"><span class="visually-hidden">Tools: </span>{job.tools.join(', ')}</p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- Projects: the featured ones with case studies, plus a link to all of them. -->
  <section id="projects" class="wrap section" aria-labelledby="projects-title">
    <h2 id="projects-title">Projects</h2>
    <p class="read muted">{featured.length} projects with full write-ups. Every result comes from the project's own test and evaluation reports.</p>
    <ol class="project-list" role="list">
      {featured.map((p) => <li><ProjectCard project={p} /></li>)}
    </ol>
    <p class="more"><a class="btn" href="/projects/">See all {total} projects</a></p>
  </section>

  <!-- Skills, grouped. -->
  <section id="skills" class="wrap section" aria-labelledby="skills-title">
    <h2 id="skills-title">Skills</h2>
    <dl class="skills">
      {skills.map((s) => (
        <div>
          <dt>{s.group}</dt>
          <dd>{s.items.join(', ')}</dd>
        </div>
      ))}
    </dl>
  </section>

  <!-- Achievements: the correction ledger (reported figure struck through, measured figure beside it),
       then certifications. -->
  <section id="achievements" class="wrap section" aria-labelledby="achievements-title">
    <h2 id="achievements-title">Achievements</h2>

    <h3 class="sub">Numbers I corrected before anyone else had to</h3>
    <p class="read muted">
      Every project here started with a figure that looked fine. These are the ones that changed most once I went
      looking for what was wrong.
    </p>
    <table class="ledger">
      <caption class="visually-hidden">Reported figures and the figures measured after checking</caption>
      <thead>
        <tr>
          <th scope="col">Project</th>
          <th scope="col">Metric</th>
          <th scope="col">Reported</th>
          <th scope="col">Measured</th>
        </tr>
      </thead>
      <tbody>
        {corrections.map((c) => (
          <tr>
            <th scope="row">
              <a href={c.href}>{c.project}</a>
              <span class="why">{c.note}</span>
            </th>
            <td data-label="Metric">{c.measure}</td>
            <td data-label="Reported" class="num before"><s><span class="visually-hidden">reported </span>{c.before}</s></td>
            <td data-label="Measured" class="num after">{c.after}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <div class="certs">
      <h3 class="sub">Certifications</h3>
      <ul class="plain">
        {certifications.map((c) => (
          <li>
            {c.url ? <a href={c.url}>{c.name}</a> : c.name}
            {c.issuer && <span class="muted">, {c.issuer}</span>}
          </li>
        ))}
      </ul>
    </div>

    <!-- Education: last part of Achievements, with no menu link of its own. -->
    <div class="certs">
      <h3 class="sub">Education</h3>
      <ul class="plain">
        {education.map((e) => (
          <li><strong>{e.title}</strong>, {e.org} <span class="muted num">({e.dates})</span></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Contact. -->
  <section id="contact" class="wrap section contact" aria-labelledby="contact-title">
    <h2 id="contact-title">Get in touch</h2>
    <p class="read">
      Hiring for a data science or AI/ML role, or need help with a model or an LLM application?
      {profile.contactFormKey ? 'Send me a message here. Email, LinkedIn and GitHub links are in the footer.' : 'Email is the fastest way to reach me.'}
    </p>
    <ContactForm />
  </section>
</Base>

<style>
  .section { margin-top: clamp(3.5rem, 8vw, 6rem); }
  .muted { color: var(--muted); }
  .small { font-size: var(--step--1); }

  /* Hero */
  .hero {
    padding-top: clamp(2.5rem, 8vw, 5.5rem);
    display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2rem 3rem; align-items: center;
  }
  .portrait img {
    display: block; width: clamp(9rem, 18vw, 13rem); height: auto; aspect-ratio: 1; border-radius: 50%;
    border: 1px solid var(--line); background: var(--surface);
    filter: var(--photo-filter);
  }
  @media (max-width: 720px) {
    .hero { grid-template-columns: 1fr; }
    .portrait { order: -1; }
    .portrait img { width: 7.5rem; }
  }
  .availability { display: flex; gap: 0.6rem; align-items: center; color: var(--muted); font-size: var(--step--1); margin: 0 0 1rem; }
  .dot { flex: none; width: 0.55rem; height: 0.55rem; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent); }
  .hero h1 { font-size: var(--step-3); margin: 0 0 0.35em; }
  /* Terminal-style role line with a blinking caret (static when the visitor prefers reduced motion). */
  .role { font-family: ui-monospace, 'Cascadia Code', Consolas, 'SFMono-Regular', Menlo, monospace; font-size: var(--step-1); color: var(--accent); margin: 0 0 1.25rem; }
  .prompt { color: var(--muted); margin-right: 0.35em; }
  .caret { display: inline-block; width: 0.55em; height: 1.1em; margin-left: 0.2em; vertical-align: -0.15em; background: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .caret { animation: none; } }
  @media (max-width: 420px) { .role { font-size: var(--step-0); } }
  .lede { font-size: var(--step-1); line-height: 1.55; color: var(--muted); }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  /* Achievements: correction ledger, then certifications */
  .sub { font-size: var(--step-1); margin-top: 1.5rem; }
  .certs { margin-top: 3rem; max-width: var(--read); }
  .ledger { width: 100%; border-collapse: collapse; margin-top: 1.5rem; }
  .ledger thead th {
    text-align: left; font-family: var(--font-body); font-weight: 600; font-size: var(--step--1);
    color: var(--muted); padding: 0 1rem 0.6rem 0; border-bottom: 2px solid var(--ink);
  }
  .ledger tbody th, .ledger td { padding: 1.1rem 1rem 1.1rem 0; border-bottom: 1px solid var(--line); vertical-align: top; text-align: left; }
  .ledger tbody th { font-weight: 600; width: 46%; }
  .ledger tbody th a { color: var(--ink); }
  .why { display: block; font-weight: 400; color: var(--muted); font-size: var(--step--1); margin-top: 0.25rem; max-width: 46ch; }
  .ledger td { white-space: nowrap; color: var(--muted); }
  .before { color: var(--amber) !important; font-size: var(--step-1); }
  .before s { text-decoration-thickness: 2px; }
  .after { color: var(--accent) !important; font-size: var(--step-2); font-weight: 700; font-family: var(--font-head); line-height: 1.1; }
  .ledger thead th:nth-child(n + 3), .ledger td.num { text-align: right; }
  .ledger td:last-child, .ledger thead th:last-child { padding-right: 0; }

  /* On small screens each row becomes a stacked block: project, then reported/measured side by side. */
  @media (max-width: 640px) {
    .ledger thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    .ledger tbody tr {
      display: grid; grid-template-columns: auto 1fr auto; column-gap: 1rem; align-items: baseline;
      padding: 1rem 0; border-bottom: 1px solid var(--line);
    }
    .ledger tbody th, .ledger td { border: 0; padding: 0; width: auto; }
    .ledger tbody th { grid-column: 1 / -1; margin-bottom: 0.6rem; }
    .ledger td.num { text-align: left; }
    .after { text-align: right !important; }
  }

  /* Projects list (card styles live in src/styles/projects.css) */
  .project-list { margin-top: 2rem; }
  .more { margin-top: 2rem; }

  /* About: hook, then intro text beside the numbers, then the three working steps. */
  .eyebrow { font-family: var(--font-body); font-size: var(--step--1); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.5rem; }
  .hook { font-family: var(--font-head); font-weight: 600; font-size: clamp(1.6rem, 1.2rem + 1.5vw, 2.25rem); line-height: 1.2; max-width: 32ch; margin: 0 0 2.5rem; color: var(--ink); }
  .about-top { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 2rem 3.5rem; align-items: start; }
  .about-text p { margin: 0 0 1rem; color: var(--muted); }
  .about-text .about-lead { font-size: var(--step-1); line-height: 1.5; color: var(--ink); }
  .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 0; }
  .stats div {
    display: flex; flex-direction: column; gap: 0.35rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.1rem 1.2rem;
  }
  .stats dd { order: -1; margin: 0; font-family: var(--font-head); font-weight: 700; font-size: var(--step-2); line-height: 1.1; color: var(--accent); }
  .stats dt { color: var(--muted); font-size: var(--step--1); line-height: 1.4; }
  .method-title { margin: 3rem 0 1rem; }
  .method { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem 2rem; }
  .method li { border-top: 2px solid var(--accent); padding-top: 0.9rem; color: var(--muted); }
  .method strong { display: block; color: var(--ink); margin-bottom: 0.25rem; }
  .step { display: block; font-family: var(--font-head); font-weight: 700; color: var(--accent); font-size: var(--step--1); margin-bottom: 0.35rem; }
  @media (max-width: 800px) {
    .about-top { grid-template-columns: 1fr; }
    .method { grid-template-columns: 1fr; }
  }

  /* Experience timeline */
  .timeline { list-style: none; padding: 0; margin: 2rem 0 0; }
  .timeline > li {
    display: grid; grid-template-columns: 11rem minmax(0, 1fr); gap: 0.25rem 2rem;
    padding: 1.5rem 0; border-top: 1px solid var(--line);
  }
  .when { color: var(--muted); font-size: var(--step--1); margin: 0.2rem 0 0; }
  .timeline h3 { margin-bottom: 0.15em; }
  .org { color: var(--muted); margin-bottom: 0.6rem; }
  .timeline ul { padding-left: 1.1rem; margin: 0; max-width: var(--read); }
  .timeline ul li { margin-bottom: 0.4rem; }
  .tools { color: var(--muted); font-size: var(--step--1); margin: 0.75rem 0 0; max-width: var(--read); }
  @media (max-width: 640px) { .timeline > li { grid-template-columns: 1fr; } }

  /* Skills */
  .skills { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr)); gap: 1.5rem 3rem; margin: 1.5rem 0 0; }
  .skills dt { font-weight: 600; margin-bottom: 0.25rem; }
  .skills dd { margin: 0; color: var(--muted); }

  /* Certifications and education lists (in Achievements) */
  .plain { list-style: none; padding: 0; margin: 0; }
  .plain li { padding: 0.5rem 0; border-bottom: 1px solid var(--line); }

</style>
